<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SSS</title>
    <script  src="https://code.jquery.com/jquery-4.0.0.min.js"
			  integrity="sha256-OaVG6prZf4v69dPg6PhVattBXkcOWQB62pdZ3ORyrao="
			  crossorigin="anonymous">
        
    </script>

    <script>

        $(function() {

            $("#zmien").on("click", function(){
                $("#tekst").text("Nowy Tekst")
            })

            $("#przelacz").on("click", function(){
                $("#pudelko").toggle("")
            })

            $(".akapit").on("click", function(){
                $(this).toggleClass("podswietlony")
            })

            $("#przywitaj").on("click", function(){
               if($("#imie").val().trim() !== ""){
                $("#wynik").text("Cześć " + $("#imie").val())
               }
            })

            $("#akceptuj").on("click", function(){
                if(this.checked){
                    $("#wysjlij").removeAttr("disabled")
                } else {
                    $("#wysjlij").attr("disabled", "disabled")
                }
            })

            $("li").each(function(index, element){
                $(element).text((index + 1) + "." + $(element).text())
            })

            $("#zaloguj").on("click", function(){
                if($("#login").val().trim() == 3 || $("#haslo").val().trim() == 6){
                    $("#komunikat").text("Zalogowano")
                } else {
                    $("#komunikat").text("Błąd")
                }
            })
        })
    </script>

    <style>
        .podswietlony {background-color: yellow;}
    </style>
</head>
<body>
    <p id="tekst">Stary tekst</p>
    <button id="zmien">Zmien</button>

    <div id="pudelko">Widzisz mnie</div>
    <button id="przelacz">Pokaż/ukryj</button>
    <p class="akapit">Kliknij</p>

    <input type="tekst" id="imie">
    <button id="przywitaj">Przywitaj</button>
    <p id="wynik"></p>

    <label><input type="checkbox" id="akceptuj"></label>
    <button id="wysjlij" disabled>Wyslij</button>

    <ul id="menu">
        <li>Strona Główna</li>
        <li>O nas</li>
        <li>Kontakt</li>
    </ul>

    <input type="text" id="login">
    <input type="password" id="haslo">
    <button id="zaloguj">Zaloguj</button>
    <p id="komunikat"></p>
</body>
</html>
