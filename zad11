<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://code.jquery.com/jquery-4.0.0.min.js" integrity="sha256-OaVG6prZf4v69dPg6PhVattBXkcOWQB62pdZ3ORyrao="
         crossorigin="anonymous">
        </script>

    <script>
        $(function(){
         $("#formularz").submit(function(e){
            e.preventDefault()
            if($("#nick").val() === ""){
                $("#indo").text("Podaj nick!")
            } else {
                $("#indo").text("wysłane")
            }
         })

         $("#logowanie").submit(function(e){
            e.preventDefault()
            if($("#haslo").length < 6){
                $("#info").text("HAslo jest zle").css("color", "red")
            } else {
                $("#info").text("zalogowano").css("color", "green")
            }
         })

         $("#kolor").change(function(){
            $("body").css("background-color", $(this).val())
         })

         $("#pizza").change(function(){
            $("#cena").text("Do zapłaty " + $(this).val() + " zł")
         })
        })
    </script>

    
    </style>
</head>
<body>
    <form id="formularz">
        <input type="text" id="nick">
        <button type="submit">wyślij</button>
    </form>
    <p id="indo"></p>
    
    <hr>

    <form id="logowanie">
        <input type="text" id="mail">
        <input type="password" id="haslo">
        <button type="submit">log</button>
    </form>

    <p id="info"></p>

    <hr>
    <select id="kolor">
        <option value="white">Biały</option>
        <option value="yellow">Żółty</option>
        <option value="lightblue">Niebieski</option>
    </select>

    <hr>

    <select id="pizza">
        <option value="20">Mała</option>
        <option value="30">Średnia</option>
        <option value="40">Duża</option>
    </select>

    <p id="cena"></p>

    <hr>
</body>
</html>
